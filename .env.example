# ============================================================
# TREFA Inference Server - Variables de Entorno
# Copia este archivo como .env y llena los valores
# ============================================================

# --- Requeridas ---

# Token de HuggingFace (para descargar el modelo)
HF_TOKEN=hf_tu_token_aqui

# Supabase (para MCP Server)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu_key_aqui

# --- Opcionales - Autenticacion ---

# API key para proteger endpoints de FastAPI
TREFA_API_KEY=
# API key para el MCP Server
MCP_API_KEY=

# --- Opcionales - Overrides de GPU (auto-detectados por defecto) ---

# Longitud maxima de contexto del modelo
# RTX 5090: 8192 | A6000: 16384 | A100/H100: 32768
MAX_MODEL_LEN=
# Porcentaje de VRAM a utilizar (0.0 - 1.0)
GPU_MEMORY_UTILIZATION=
# Tipo de datos para inferencia
DTYPE=half

# --- Opcionales - Generacion de datasets ---

# Anthropic API key (generacion sintetica)
TREFA_ANTHROPIC_API_KEY=
# Google Gemini API key (curacion/pipeline)
TREFA_GEMINI_API_KEY=
